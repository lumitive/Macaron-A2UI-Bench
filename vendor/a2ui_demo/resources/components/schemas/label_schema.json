{
  "type": "object",
  "properties": {
    "text": {
      "type": "object",
      "description": "The text content to display.",
      "properties": {
        "path": {
          "type": "string",
          "description": "A relative or absolute path in the data model."
        },
        "literalString": {
          "type": "string"
        }
      }
    },
    "color": {
      "type": "string",
      "description": "The color level of the label text. Defaults to \"label\" (primary text color).",
